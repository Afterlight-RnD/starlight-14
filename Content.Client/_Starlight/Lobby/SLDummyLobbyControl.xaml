<controls:SLDummyLobbyControl
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Starlight.Lobby"
    xmlns:controls1="clr-namespace:Content.Client._Starlight.UI.Controls"
    xmlns:layers="clr-namespace:Content.Client._Starlight.Lobby.Layers"
    xmlns:layers1="clr-namespace:Content.Client._Starlight.CharacterEditor.Layers"
    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
    HorizontalExpand="True" VerticalExpand="True">
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <controls1:ControlStack Name="LobbyStack" Access="Protected">
        <layers:StarlightLobbyLayer Name="Lobby" Access="Protected"/>
        <layers1:CharacterEditorLayer Name="CharacterEditor" Access="Protected" Visible="False"/>
    </controls1:ControlStack>
</controls:SLDummyLobbyControl>
