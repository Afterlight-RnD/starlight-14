<controls:LobbyLinkBannerWidget
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client._Starlight.Lobby.Widgets"
    xmlns:slcontrols="clr-namespace:Content.Client._Starlight.Lobby.Controls"
    xmlns:changelog="clr-namespace:Content.Client.Changelog"
    xmlns:info="clr-namespace:Content.Client.Info"
    Orientation="Horizontal">
    <GridContainer Name="LinkBannerButtonGrid" Access="Public">
        <slcontrols:WindowButton
            Name="RulesButton" Access="Public"
            Text="{Loc 'server-info-rules-button'}"
            WindowType="{x:Type info:RulesAndInfoWindow}"/>
        <slcontrols:URIButton
            Name="DiscordButton" Access="Public"
            Text= "{Loc 'server-info-discord-button'}"
            HideWhenInvalid="False"/>
        <slcontrols:URIButton
            Name="WebsiteButton" Access="Public"
            Text= "{Loc 'server-info-website-button'}"
            HideWhenInvalid="False"/>
        <slcontrols:URIButton
            Name="WikiButton" Access="Public"
            Text= "{Loc 'server-info-wiki-button'}"
            HideWhenInvalid="False"/>
        <slcontrols:URIButton
            Name="ForumButton" Access="Public"
            Text= "{Loc 'server-info-forum-button'}"
            HideWhenInvalid="False"/>
        <slcontrols:URIButton
            Name="TelegramButton" Access="Public"
            Text= "{Loc 'server-info-telegram-button'}"
            HideWhenInvalid="False"/>
        <slcontrols:URIButton
            Name="LinkDiscord" Access="Public"
            Text="{Loc 'server-info-connect-discord-button'}"
            HideWhenInvalid="False"/>
        <slcontrols:GuidebookButton/>
        <changelog:ChangelogButton Name="ChangelogButton" Access="Public"/>
    </GridContainer>
</controls:LobbyLinkBannerWidget>
