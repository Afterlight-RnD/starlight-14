<controls:LobbyLinkBannerWidget
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Starlight.Lobby.Widgets"
    xmlns:slcontrols="clr-namespace:Content.Client._Starlight.Lobby.Controls"
    xmlns:changelog="clr-namespace:Content.Client.Changelog"
    Orientation="Horizontal"
    >
    <slcontrols:RulesButton Name="RulesButton" Access="Public"/>
    <slcontrols:URIButton Name="DiscordButton" Access="Public" Text= "{Loc 'server-info-discord-button'}"/>
    <slcontrols:URIButton Name="WebsiteButton" Access="Public" Text= "{Loc 'server-info-website-button'}"/>
    <slcontrols:URIButton Name="WikiButton" Access="Public" Text= "{Loc 'server-info-wiki-button'}"/>
    <slcontrols:URIButton Name="ForumButton" Access="Public" Text= "{Loc 'server-info-forum-button'}"/>
    <slcontrols:URIButton Name="TelegramButton" Access="Public" Text= "{Loc 'server-info-telegram-button'}"/>
    <slcontrols:URIButton
        Name="LinkDiscord" Access="Public"
        Text="{Loc 'server-info-connect-discord-button'}"
        VisibleWithoutURI="False"/>
    <slcontrols:GuidebookButton/>
    <changelog:ChangelogButton Name="ChangelogButton" Access="Public"/>
</controls:LobbyLinkBannerWidget>
