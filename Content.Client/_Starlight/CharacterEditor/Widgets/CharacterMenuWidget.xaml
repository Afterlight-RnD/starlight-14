<controls:CharacterMenuWidget
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Starlight.CharacterEditor.Widgets"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Center">
        <Button Name="SelectCharacter" Access="Public" Text="{Loc 'character-editor-open-character-list-button'}"/>
        <Button Name="CreateCharacter" Access="Protected" Text="{Loc 'character-editor-create-character-button'}"/>
        <controls1:StripeBack HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Button Name="SaveChanges" Access="Protected"
                        Disabled="True"
                        Text="{Loc 'character-editor-save-character-changes-button'}"/>
                <Button Name="DiscardChanges" Access="Protected"
                        Disabled="True"
                        Text="{Loc 'character-editor-discard-character-changes-button'}"/>
            </BoxContainer>
        </controls1:StripeBack>

    </BoxContainer>
</controls:CharacterMenuWidget>
