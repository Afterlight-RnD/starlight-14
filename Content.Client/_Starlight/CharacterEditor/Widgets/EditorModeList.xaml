<widgets:EditorModeList
    xmlns="https://spacestation14.io"
    xmlns:widgets="clr-namespace:Content.Client._Starlight.CharacterEditor.Widgets"
    xmlns:editorModes="clr-namespace:Content.Client._Starlight.CharacterEditor.EditorModes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client._Starlight.CharacterEditor.Controls"
    Orientation="Vertical">
    <controls:EditorModeButton
        ModeName="{Loc 'character-editor-select-slot-button'}"
        EditingPanelType="{x:Type 'editorModes:CharacterSlotSelectionMode'}"/>
    <controls:EditorModeButton
        ModeName="{Loc 'character-editor-select-species-button'}"
        EditingPanelType="{x:Type 'editorModes:SpeciesSelectMode'}"/>
</widgets:EditorModeList>
