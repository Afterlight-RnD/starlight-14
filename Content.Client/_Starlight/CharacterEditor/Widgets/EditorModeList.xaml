<widgets:EditorModeList
    xmlns="https://spacestation14.io"
    xmlns:widgets="clr-namespace:Content.Client._Starlight.CharacterEditor.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client._Starlight.CharacterEditor.Controls"
    xmlns:species="clr-namespace:Content.Client._Starlight.CharacterEditor.Editors.Species"
    xmlns:bodyTypeEditor="clr-namespace:Content.Client._Starlight.CharacterEditor.Editors.BodyTypeEditor"
    Orientation="Vertical">
    <controls:EditorModeButton
        ModeName="{Loc 'character-editor-select-species-button'}"
        EditingPanelType="{x:Type 'bodyTypeEditor:BodyTypeEditor'}"
        DetailsPanelType="{x:Type 'species:SpeciesSelector'}"/>
</widgets:EditorModeList>
