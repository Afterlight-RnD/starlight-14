<widgets:CharacterEditorMenuBarWidget
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:slcontrols="clr-namespace:Content.Client._Starlight.Lobby.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:stats="clr-namespace:Content.Client.Info.PlaytimeStats"
    xmlns:widgets="clr-namespace:Content.Client._Starlight.CharacterEditor.Widgets"
    Orientation="Horizontal">
    <slcontrols:WindowButton
        Name="StatsButton" HorizontalExpand="True"
        Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
        WindowType="{x:Type stats:PlaytimeStatsWindow}"
        StyleClasses="ButtonBig"
        HorizontalAlignment="Right" />
    <cc:CommandButton
        Name="AdminRemarksButton"
        Command="adminremarks"
        Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
        StyleClasses="ButtonBig" />
    <slcontrols:WindowButton
        Name="RulesButton" Access="Public"
        Text="{Loc 'server-info-rules-button'}"
        WindowType="{x:Type info:RulesAndInfoWindow}"
        StyleClasses="ButtonBig" />
    <Button
        Name="CloseButton"
        Access="Public"
        Text="{Loc 'character-setup-gui-character-setup-close-button'}"
        StyleClasses="ButtonBig"/>
</widgets:CharacterEditorMenuBarWidget>
