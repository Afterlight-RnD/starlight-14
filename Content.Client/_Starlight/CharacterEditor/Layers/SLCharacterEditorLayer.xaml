<layers:SLCharacterEditorLayer
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:widgets="clr-namespace:Content.Client._Starlight.Lobby.Widgets"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:widgets2="clr-namespace:Content.Client._Starlight.Character.Editor.Widgets"
    xmlns:layers="clr-namespace:Content.Client._Starlight.CharacterEditor.Layers"
    xmlns:widgets1="clr-namespace:Content.Client._Starlight.CharacterEditor.Widgets"
    xmlns:slcontrols="clr-namespace:Content.Client._Starlight.UI.Controls"
    xmlns:widgets3="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <PanelContainer Name="BackgroundPanel" Access="Protected"
                    Margin="10" HorizontalExpand="True" VerticalExpand="True"
                    StyleClasses="AngleRect" ModulateSelfOverride="#1f1f23">
        <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="0"
                      HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Stretch">
            <!-- This holds the buttons in the top right of the window -->
            <BoxContainer Orientation="Horizontal" MinSize="0 40">
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                       Margin="8 0 0 0" VAlign="Center"
                       StyleClasses="LabelHeadingBigger"
                       HorizontalAlignment="Left" />
                <Control HorizontalExpand="True" HorizontalAlignment="Stretch" /> <!-- Spacer -->
                <widgets1:CharacterEditorMenuBarWidget
                    Name="MenuBar" Access="Protected"
                    HorizontalAlignment="Right" />
            </BoxContainer>

            <!-- Horizontal rule -->
            <controls:HLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
            <BoxContainer
                Orientation="Horizontal" SeparationOverride="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalExpand="True" VerticalExpand="True">
                <!-- Left side button list-->
                <BoxContainer MinSize="400 0" Margin="5 0 0 0" Orientation="Vertical">
                    <controls:StripeBack HorizontalExpand="True">
                        <widgets:RoundTimerWidget HorizontalAlignment="Center" HorizontalExpand="True" />
                    </controls:StripeBack>
                    <!-- Horizontal rule -->
                    <controls:HLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
                    <!-- <widgets2:CharacterEditorProfileList/> -->
                    <widgets1:EditorModeList Name="EditorModeSelector" Access="Protected" />
                </BoxContainer> <!-- End "Left side of the window" -->
                <slcontrols:VLine Thickness="2" Color="{x:Static style:StyleNano.NanoGold}" />
                <BoxContainer
                    Orientation="Horizontal"
                    HorizontalExpand="True" VerticalExpand="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <BoxContainer
                        Name="PopoutPanel" Access="Protected"
                        Orientation="Vertical" Visible="False"
                        HorizontalExpand="True" VerticalExpand="True"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                    <BoxContainer Orientation="Vertical"
                                  VerticalExpand="True" HorizontalExpand="True">
                        <Label Text="Urist McPlaceholder"
                               VerticalExpand="True" HorizontalExpand="True"
                               HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <controls:HLine
                            HorizontalExpand="True" HorizontalAlignment="Stretch"
                            Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
                        <ScrollContainer HScrollEnabled="False"
                                         VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer
                                Name="EditingPanel" Access="Protected"
                                HorizontalExpand="True" VerticalExpand="False"
                                HorizontalAlignment="Stretch" />
                        </ScrollContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalExpand="True" VerticalExpand="True"
                                  VerticalAlignment="Stretch">
                        <slcontrols:VLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
                        <BoxContainer Orientation="Vertical" MinWidth="150"
                                      HorizontalExpand="True" VerticalExpand="True"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <ScrollContainer HScrollEnabled="False"
                                             VerticalExpand="True" HorizontalExpand="True">
                                <BoxContainer
                                            Name="DetailsPanel" Access="Protected"
                                            HorizontalExpand="True" VerticalExpand="true"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </ScrollContainer>

                            <BoxContainer Orientation="Vertical"
                                          VerticalExpand="True" HorizontalExpand="True"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Bottom" >
                                <controls:HLine VerticalAlignment="Bottom"
                                                Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
                                <widgets3:ChatBox
                                    Name="Chat" Access="Public"
                                    VerticalExpand="True" Margin="3 3 3 3" MinSize="300 150"
                                    VerticalAlignment="Stretch"/>
                            </BoxContainer>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</layers:SLCharacterEditorLayer>
