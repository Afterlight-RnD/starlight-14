<bodyType:IdentityPanel
    xmlns="https://spacestation14.io"
    xmlns:bodyType="clr-namespace:Content.Client._Starlight.CharacterEditor.Editors"
    xmlns:controls="clr-namespace:Content.Client._Starlight.CharacterEditor.Controls"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets">
    <controls:CharacterEditorField
        Name="FirstNameField" Access="Protected" HorizontalAlignment="Center"
        LabelText="First Name: " TextEditWidth="250" />
    <controls:CharacterEditorField
        Name="NicknameField" Access="Protected"
        LabelText="Nickname:  " TextEditWidth="250" HorizontalAlignment="Center"/>
    <controls:CharacterEditorField
        Name="LastNameField" Access="Protected" HorizontalAlignment="Center"
        LabelText="Last Name: " TextEditWidth="250" />
    <PanelContainer>
        <Label Name="NameRuleDisclaimer" Access="Protected" HorizontalAlignment="Center"/>
    </PanelContainer>

    <controls1:HLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2"/>

    <GridContainer Columns="2" HSeparationOverride="5" VSeparationOverride="5"
                   HorizontalAlignment="Center">
        <controls:CharacterEditorField
            Name="CharacterBodyTypeField" Access="Protected" HorizontalAlignment="Center"
            LabelText="BodyType: "/>

        <controls:CharacterEditorField
            Name="CharacterPronounField" Access="Protected" HorizontalAlignment="Center"
            LabelText="Pronouns: "/>

        <controls:CharacterEditorField
            Name="CharacterPhysicalAgeField" Access="Protected" HorizontalAlignment="Center"
            LabelText="Physical Age: " TextEditWidth="50" />

        <controls:CharacterEditorField
            Name="CharacterChronologicalAgeField" Access="Protected" HorizontalAlignment="Center"
            LabelText="Chronological Age: " TextEditWidth="50" />

    </GridContainer>
</bodyType:IdentityPanel>
