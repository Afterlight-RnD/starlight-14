<species:SpeciesSelectorPanel
    xmlns="https://spacestation14.io"
    xmlns:species="clr-namespace:Content.Client._Starlight.CharacterEditor.Editors.Species"
    xmlns:controls="clr-namespace:Content.Client._Starlight.CharacterEditor.Editors.Species.Controls"
    xmlns:controls2="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    Orientation="Vertical">
    <Label Text="Species"  HorizontalExpand="True" HorizontalAlignment="Center"/>
    <controls:SpeciesGroupList GroupName="Biological" Columns="6" HorizontalAlignment="Center"/>
    <controls2:HLine Color="{xNamespace:Static style:StyleNano.NanoGold}" Thickness="2" />
    <BoxContainer Name="LowerSection" Access="Protected">
        <BoxContainer
            Orientation="Vertical"
            Name="SpeciesDescriptionBox" Access="Protected">
        </BoxContainer>
        <BoxContainer
            Orientation="Horizontal"
            Name="CustomSpeciesBox" Access="Protected">
        </BoxContainer>
    </BoxContainer>
</species:SpeciesSelectorPanel>
