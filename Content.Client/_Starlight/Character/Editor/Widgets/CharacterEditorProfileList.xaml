<widgets:CharacterEditorProfileList
    xmlns="https://spacestation14.io"
    xmlns:widgets="clr-namespace:Content.Client._Starlight.Character.Editor.Widgets"
    Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="0 5 0 0">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
            <BoxContainer Name="CharactersList" Access="Protected"
                          Orientation="Vertical" VerticalExpand="True" />
        </ScrollContainer>
        <Button Name="NewSlotButton" Access="Protected"
                Text="{Loc 'create-new-slot'}"
                StyleClasses="BigButton" HorizontalExpand="True" />
    </BoxContainer>
</widgets:CharacterEditorProfileList>
